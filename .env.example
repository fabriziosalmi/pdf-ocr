# Copy to .env and adjust. `.env` is gitignored — never commit real values.

# REQUIRED outside development. Signs the session cookie; the app refuses to
# start without it unless FLASK_ENV=development.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# --- Serving ---------------------------------------------------------------
PORT=8011
WEB_CONCURRENCY=2          # gunicorn worker processes
WEB_THREADS=4              # threads per worker
WEB_TIMEOUT=120            # seconds; must cover a full upload

# Set to true when serving over HTTPS: marks the session cookie Secure and
# enables HSTS.
SESSION_COOKIE_SECURE=false

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=64           # rejected with 413 above this
MAX_PAGES=200              # pages per PDF
RENDER_BATCH_SIZE=4        # pages rendered per Poppler call (peak memory)

# A conversion updates its record after every page. If one stops updating for
# longer than this it is treated as abandoned (worker recycled, container
# restarted) and reported as failed instead of pending forever. Raise it if you
# OCR very large pages on slow hardware.
STALE_TASK_TIMEOUT=1800

# --- Storage / logging -----------------------------------------------------
UPLOAD_FOLDER=uploads
LOG_LEVEL=INFO
# Leave unset to log only to stdout. If set, rotates at 10 MB, 3 backups.
# LOG_FILE=/app/app.log

# Set to true inside the container image. Skips the local Tesseract/Poppler
# probes, since the image is built with both.
DOCKER_ENV=false

# --- Development only ------------------------------------------------------
# Enables the Werkzeug debugger, which is remote code execution. Never set
# this in a deployment.
# FLASK_ENV=development
